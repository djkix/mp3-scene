# Copier en .env (docker compose le lit automatiquement) puis remplacer les valeurs.
# Générer SECRET_KEY :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USER=admin
# Au moins 8 caractères. Utilisé uniquement tant qu'aucun compte n'existe : à retirer de ce fichier après le premier démarrage
ADMIN_PASSWORD=
# Facultatif : jeton personnel Discogs (compte gratuit, Paramètres › Développeurs), pour chercher aussi les pochettes
# sur Discogs et voir ce qui manque d'un label (décommenter aussi la ligne du compose)
# DISCOGS_TOKEN=
# Facultatif : onglet Navidrome (Explorer). Compte d'un serveur Navidrome, lu par le serveur Mp3 Scene seulement
# (jamais envoyé au navigateur). Adresse vue depuis le conteneur, sans slash final.
# NAVIDROME_URL=http://192.168.1.201:4533
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=
